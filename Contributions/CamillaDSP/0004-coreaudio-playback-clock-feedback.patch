+#[cfg(test)]
+mod playback_clock_protocol_tests {
+    use super::*;
+
+    #[test]
+    fn playback_clock_command_and_pending_reply() {
+        assert_eq!(serde_json::from_str::<WsCommand>(r#""GetPlaybackClock""#).unwrap(), WsCommand::GetPlaybackClock);
+        let reply = serde_json::to_value(WsReply::GetPlaybackClock { result: WsResult::Ok, value: None }).unwrap();
+        assert_eq!(reply["GetPlaybackClock"]["result"], "Ok");
+        assert!(reply["GetPlaybackClock"]["value"].is_null());
+    }
+
+    #[test]
+    fn playback_clock_reply_preserves_epoch_and_raw_host_ticks() {
+        let clock = crate::PlaybackClock { epoch: 7, sample_time: 512.0,
+            host_time: 123456789012345, nominal_rate: 48000, timestamp_flags: 3,
+            callback_frames: 512, buffered_frames: 1536, demand_frames: 1024, underrun_frames: 0 };
+        let reply = serde_json::to_value(WsReply::GetPlaybackClock { result: WsResult::Ok, value: Some(clock) }).unwrap();
+        let value = &reply["GetPlaybackClock"]["value"];
+        assert_eq!(value["epoch"], 7);
+        assert_eq!(value["host_time"].as_u64(), Some(clock.host_time));
+        assert_eq!(value["timestamp_flags"], 3);
+        assert_eq!(value["underrun_frames"], 0);
+        assert_eq!(value["buffered_frames"], 1536);
+    }
+}
