+    pub epoch: u64,
+    pub sample_time: f64,
+    pub host_time: u64,
+    pub nominal_rate: usize,
+    pub timestamp_flags: u32,
+    pub callback_frames: usize,
+    pub buffered_frames: usize,
+    pub demand_frames: u64,
+    pub underrun_frames: u64,
+}
